# Target aliases.

build MandelbrotRenderer: phony bin/MandelbrotRenderer

build SDL2: phony bin/libSDL2-2.0d.so

build SDL2-static: phony extern/SDL2/libSDL2d.a

build SDL2_test: phony extern/SDL2/libSDL2_test.a

build SDL2main: phony extern/SDL2/libSDL2maind.a

build libSDL2-2.0d.so: phony bin/libSDL2-2.0d.so

build libSDL2_test.a: phony extern/SDL2/libSDL2_test.a

